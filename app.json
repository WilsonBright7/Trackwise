{
  "expo": {
    "name": "Trackwise",
    "slug": "Trackwise",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/trackwise.png",
    "scheme": "trackwise",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/tracksplash.png",
      "backgroundColor": "#26A69A",
      "resizeMode": "contain"
    },
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.GROUP3.TRACKWISE",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/tracksplash.png",
        "backgroundColor": "#26A69A"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.GROUP3.TRACKWISE"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/tracksplash.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/tracksplash.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#26A69A"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b12742ca-af24-45e9-a7c2-295e7b21f846"
      }
    }
  }
}
